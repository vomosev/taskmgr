# ---------------------------------------------------------------------------
# TaskMgr — example environment configuration
# Copy this file to `.env` and replace every placeholder with a real value.
# Never commit your real `.env` file.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the Express API binds to (4116 in production).
PORT=4116

# Node environment: development | production
NODE_ENV=production

# --- TLS --------------------------------------------------------------------
# Set to 'true' to make the API terminate TLS itself using the files below.
SSL_ENABLED=true

# Absolute path to the TLS certificate file.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key file.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA bundle file. Leave blank if not required.
SSL_CA_PATH=/home/arx-app/backends/certs/ca_bundle.crt

# --- Database (MySQL) -------------------------------------------------------
# MySQL host name.
DB_HOST=localhost

# MySQL user name.
DB_USER=taskmgr_user

# MySQL user password (placeholder — change me).
DB_PASSWORD=change_me_db_password

# MySQL database name (apply schema.sql to this database).
DB_NAME=taskmgr

# --- Sessions ---------------------------------------------------------------
# Secret used to sign the session cookie. Use a long random string.
SESSION_SECRET=change_me_to_a_long_random_session_secret

# Domain the session cookie is scoped to so the frontend and API share it.
COOKIE_DOMAIN=.arx-app.com

# --- CORS -------------------------------------------------------------------
# Comma separated list of extra allowed origins in addition to *.arx-app.com.
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------------
# Public base URL of the backend API used by the browser (build + runtime).
NEXT_PUBLIC_API_URL=https://taskmgr-api.arx-app.com:4116